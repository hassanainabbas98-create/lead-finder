# Application Configuration
APP_NAME="Business Opportunity Finder"
APP_ENV=production
DEBUG=False
PORT=8000
HOST=0.0.0.0
SECRET_KEY=lead-finder-secret-key-change-in-production

# Database
DATABASE_URL=sqlite:///./opportunity_finder.db

# OpenStreetMap / Overpass Mirror Servers
OVERPASS_SERVERS=["https://overpass-api.de/api/interpreter","https://overpass.kumi.systems/api/interpreter","https://lz4.overpass-api.de/api/interpreter"]
NOMINATIM_USER_AGENT=BusinessOpportunityFinder/1.0
OVERPASS_TIMEOUT_SECONDS=60
DEFAULT_SEARCH_MAX_RESULTS=100

# Website Scraping Safeguards
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_REDIRECTS=5
MAX_RESPONSE_SIZE_BYTES=5242880
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36
